{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/hamperman/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/score/:score",
      "destination": "/api/score?score=:score"
    }
  ]
}
